---
import Layout from "../layouts/Layout.astro";
import SectionContainer from "../components/SectionContainer.astro";
import ScrambleText from "../components/ScrambleText.astro";

const examples = [
  {
    label: "Velocidad rápida · 0.5s",
    text: "ACCESO CONCEDIDO",
    speed: 0.5,
    characters: "01",
    color: "text-cyan-300",
    border: "border-cyan-400/20",
    glow: "shadow-[0_0_35px_-12px_rgba(34,211,238,0.45)]",
  },
  {
    label: "Velocidad media · 1.1s",
    text: "SISTEMA COMPROMETIDO",
    speed: 1.1,
    characters: undefined,
    color: "text-emerald-300",
    border: "border-emerald-400/20",
    glow: "shadow-[0_0_35px_-12px_rgba(52,211,153,0.45)]",
  },
  {
    label: "Velocidad lenta · 2s",
    text: "RASTRO ELIMINADO",
    speed: 2,
    characters: "ΑΒΓΔΕΖΗΘΙΚΛΜΝΞΟΠΡΣΤΥΦΧΨΩ",
    color: "text-fuchsia-300",
    border: "border-fuchsia-400/20",
    glow: "shadow-[0_0_35px_-12px_rgba(232,121,249,0.45)]",
  },
];
---

<Layout
  title="Scramble Text · Demo"
  description="Componente de revelación de texto estilo Matrix/Cyberpunk con GSAP y Astro."
>
  <main class="px-4">
    <SectionContainer class="pt-32 pb-20 md:pt-40">
      <!-- ================================================================ -->
      <!-- Hero de la demo                                                   -->
      <!-- ================================================================ -->
      <div
        class="relative overflow-hidden rounded-2xl border border-emerald-400/25 bg-gray-950 p-6 shadow-[0_0_80px_-20px_rgba(16,185,129,0.5)] sm:p-10"
      >
        <!-- Retícula decorativa -->
        <div
          class="pointer-events-none absolute inset-0 opacity-40 bg-[linear-gradient(rgba(16,185,129,0.09)_1px,transparent_1px),linear-gradient(90deg,rgba(16,185,129,0.09)_1px,transparent_1px)] bg-[length:32px_32px]"
          aria-hidden="true"
        >
        </div>

        <div class="relative">
          <div
            class="flex items-center gap-2 font-mono text-[11px] uppercase tracking-[0.3em] text-emerald-400/80"
          >
            <span class="size-2 animate-pulse rounded-full bg-emerald-400"></span>
            GSAP // Scramble Protocol
          </div>

          <ScrambleText
            id="demo-title"
            as="h1"
            text="CYBERPUNK PROTOCOL"
            speed={1.8}
            class="mt-5 font-mono text-4xl font-bold uppercase tracking-tight text-emerald-300 drop-shadow-[0_0_18px_rgba(52,211,153,0.55)] sm:text-6xl"
          />

          <ScrambleText
            as="p"
            text="Inicializando secuencia... la señal se estabiliza letra por letra."
            speed={2.6}
            delay={0.15}
            characters="01<>[]{}#$%&*+-=/\\|"
            class="mt-5 max-w-2xl font-mono text-sm text-emerald-100/70 sm:text-base"
          />

          <div class="mt-8 flex flex-wrap items-center gap-4">
            <button
              type="button"
              data-replay-scramble
              class="group relative inline-flex items-center gap-2 overflow-hidden rounded-full border border-emerald-400/40 bg-emerald-400/10 px-5 py-2.5 font-mono text-sm font-semibold text-emerald-300 transition hover:border-emerald-300 hover:bg-emerald-400/20 hover:text-emerald-200 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-400"
            >
              <span class="size-1.5 rounded-full bg-emerald-400 transition group-hover:scale-150"></span>
              Repetir animación
            </button>

            <span class="font-mono text-xs text-emerald-100/40">
              Reinicia todas las instancias de la página
            </span>
          </div>
        </div>
      </div>

      <!-- ================================================================ -->
      <!-- Ejemplos con distintas velocidades y alfabetos                     -->
      <!-- ================================================================ -->
      <div class="mt-10 grid gap-4 sm:grid-cols-3">
        {
          examples.map((example) => (
            <div
              class:list={[
                "rounded-xl border bg-gray-950 p-5",
                example.border,
                example.glow,
              ]}
            >
              <p class="font-mono text-[10px] uppercase tracking-[0.25em] text-gray-500">
                {example.label}
              </p>
              <ScrambleText
                as="p"
                text={example.text}
                speed={example.speed}
                characters={example.characters}
                class:list={[
                  "mt-3 font-mono text-lg font-bold tracking-tight",
                  example.color,
                ]}
              />
            </div>
          ))
        }
      </div>

      <!-- ================================================================ -->
      <!-- Documentación rápida                                               -->
      <!-- ================================================================ -->
      <div class="mt-10 grid gap-4 lg:grid-cols-2">
        <div class="rounded-xl border border-gray-200 bg-white/60 p-5 dark:border-gray-800 dark:bg-gray-900/40">
          <h2 class="font-mono text-sm font-semibold uppercase tracking-[0.2em] text-emerald-600 dark:text-emerald-400">
            Uso del componente
          </h2>
          <pre class="mt-4 overflow-x-auto rounded-lg bg-gray-950 p-4 font-mono text-xs leading-relaxed text-emerald-200"><code>{`<ScrambleText
  text="SYSTEM ONLINE"
  as="h1"
  speed={1.4}
  class="text-5xl font-mono"
/>`}</code></pre>
        </div>

        <div class="rounded-xl border border-gray-200 bg-white/60 p-5 dark:border-gray-800 dark:bg-gray-900/40">
          <h2 class="font-mono text-sm font-semibold uppercase tracking-[0.2em] text-emerald-600 dark:text-emerald-400">
            Repetir con un botón
          </h2>
          <pre class="mt-4 overflow-x-auto rounded-lg bg-gray-950 p-4 font-mono text-xs leading-relaxed text-emerald-200"><code>{`const el = document.querySelector(
  "[data-scramble-text]"
);

el?.dispatchEvent(
  new CustomEvent("scramble:play")
);`}</code></pre>
          <p class="mt-3 text-xs text-gray-500 dark:text-gray-400">
            El componente también emite <code class="text-emerald-600 dark:text-emerald-400">scramble:start</code>
            y <code class="text-emerald-600 dark:text-emerald-400">scramble:end</code>.
          </p>
        </div>
      </div>

      <p class="mt-8 text-center font-mono text-xs text-gray-400">
        Página de prueba del componente
        <code class="text-emerald-600 dark:text-emerald-400">ScrambleText.astro</code>
      </p>
    </SectionContainer>
  </main>
</Layout>

<script>
  const bindReplayButton = (): void => {
    const button = document.querySelector<HTMLButtonElement>(
      "[data-replay-scramble]"
    );

    // Evita registrar el listener dos veces (carga inicial + ViewTransitions).
    if (!button || button.dataset.bound === "true") return;
    button.dataset.bound = "true";

    button.addEventListener("click", () => {
      document
        .querySelectorAll<HTMLElement>("[data-scramble-text]")
        .forEach((element) => {
          element.dispatchEvent(new CustomEvent("scramble:play"));
        });
    });
  };

  document.addEventListener("astro:page-load", bindReplayButton);

  if (document.readyState !== "loading") {
    bindReplayButton();
  }
</script>
