---
/**
 * ScrambleText
 * ---------------------------------------------------------------------------
 * Efecto de revelación aleatoria tipo "Matrix" / "Cyberpunk" usando GSAP.
 *
 * Uso básico:
 *
 *   <ScrambleText
 *     text="Hola mundo"
 *     as="h1"
 *     speed={1.4}
 *     class="text-5xl font-mono"
 *   />
 *
 * Repetir la animación desde cualquier parte de la página:
 *
 *   const el = document.querySelector('[data-scramble-text]');
 *   el?.dispatchEvent(new CustomEvent('scramble:play'));
 *
 * Eventos emitidos:
 *   - scramble:start  → al comenzar (o reiniciarse) la animación.
 *   - scramble:end    → cuando todas las letras quedaron fijadas.
 */
interface Props {
  /** Texto final que se muestra al terminar la animación. */
  text: string;
  /** Duración total de la animación en segundos. */
  speed?: number;
  /** Retardo antes de iniciar, en segundos. */
  delay?: number;
  /** Etiqueta HTML a renderizar. */
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6" | "p" | "span" | "div";
  /** Caracteres usados durante el caos aleatorio. */
  characters?: string;
  /** Reproducir al entrar en el viewport (una sola vez). */
  playOnView?: boolean;
  /** Respetar prefers-reduced-motion mostrando el texto final sin animar. */
  respectReducedMotion?: boolean;
  /** Clases CSS adicionales. */
  class?: string;
  /** ID del elemento contenedor. */
  id?: string;
  /** Permite pasar atributos HTML extra (aria-*, data-*, style, etc.). */
  [attribute: string]: unknown;
}

const {
  text,
  speed = 1.2,
  delay = 0,
  as: Tag = "span",
  characters = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789#$%&*+-=<>[]{}",
  playOnView = false,
  respectReducedMotion = true,
  class: className = "",
  id,
  ...rest
} = Astro.props as Props;

const charset = characters.trim() || "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789";
---

<Tag
  {...rest}
  id={id}
  class:list={["scramble-text", className]}
  data-scramble-text={text}
  data-scramble-speed={speed}
  data-scramble-delay={delay}
  data-scramble-chars={charset}
  data-scramble-play-on-view={playOnView ? "true" : "false"}
  data-scramble-reduced-motion={respectReducedMotion ? "true" : "false"}
  data-scramble-state="idle"
>
  <!-- Texto accesible: los lectores de pantalla siempre leen el texto final. -->
  <span class="scramble-text__sr">{text}</span>

  <!-- Capa invisible que reserva el tamaño final y evita saltos de layout. -->
  <span class="scramble-text__measure" aria-hidden="true">{text}</span>

  <!-- Capa animada superpuesta. El texto se reemplaza en cliente. -->
  <span class="scramble-text__output" data-scramble-output aria-hidden="true">
    {text}
  </span>
</Tag>

<style>
  .scramble-text {
    position: relative;
    display: inline-block;
    max-width: 100%;
  }

  .scramble-text__sr {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border-width: 0;
  }

  .scramble-text__measure {
    visibility: hidden;
    white-space: pre-wrap;
  }

  .scramble-text__output {
    position: absolute;
    inset: 0;
    display: block;
    white-space: pre-wrap;
    pointer-events: none;
  }

  /*
   * Mientras se anima, los glifos aleatorios pueden ocupar más ancho que el
   * texto final. Recortamos la capa animada a la caja reservada para evitar
   * que invada el contenido siguiente. Al terminar, el recorte se desactiva
   * para no cortar sombras/glows del texto final.
   */
  .scramble-text[data-scramble-state="playing"] .scramble-text__output {
    overflow: hidden;
  }
</style>

<script>
  import { gsap } from "gsap";

  const DEFAULT_CHARSET =
    "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789#$%&*+-=<>[]{}";

  interface ScrambleChar {
    final: string;
    isWhitespace: boolean;
    /** Último glifo mostrado (final o aleatorio). */
    current: string;
    /** Punto normalizado (0–1) en el que este carácter queda fijado. */
    revealAt: number;
  }

  /** Evita inicializar dos veces el mismo elemento (ViewTransitions, HMR, etc.). */
  const initialized = new WeakSet<HTMLElement>();
  const activeTweens = new WeakMap<HTMLElement, gsap.core.Tween>();

  const toNumber = (value: string | undefined, fallback: number): number => {
    const parsed = Number.parseFloat(value ?? "");
    return Number.isFinite(parsed) ? parsed : fallback;
  };

  const getGlyphs = (charset: string): string[] =>
    Array.from(charset.trim() || DEFAULT_CHARSET);

  const randomGlyph = (glyphs: string[]): string =>
    glyphs[Math.floor(Math.random() * glyphs.length)] ?? "";

  /** Divide el texto en grafemas reales (emoji, acentos combinados, etc.). */
  const splitGraphemes = (text: string): string[] => {
    type GraphemeSegmenter = new (
      locale?: string,
      options?: { granularity: "grapheme" }
    ) => {
      segment: (input: string) => Iterable<{ segment: string }>;
    };

    const Segmenter = (
      Intl as typeof Intl & { Segmenter?: GraphemeSegmenter }
    ).Segmenter;

    if (Segmenter) {
      return Array.from(
        new Segmenter("es", { granularity: "grapheme" }).segment(text),
        (part) => part.segment
      );
    }

    return Array.from(text);
  };

  /**
   * Asigna a cada carácter un momento de "fijación" con un pequeño desorden.
   * El resultado: las letras se estabilizan de izquierda a derecha sin que
   * todas terminen exactamente en el mismo frame.
   */
  const randomizeSchedule = (states: ScrambleChar[]): void => {
    const total = Math.max(1, states.length);

    states.forEach((state, index) => {
      if (state.isWhitespace) {
        state.revealAt = 0;
        return;
      }

      const order = total === 1 ? 1 : index / (total - 1);
      const jitter = (Math.random() - 0.5) * 0.18;
      state.revealAt = gsap.utils.clamp(0.3, 0.95, 0.35 + order * 0.5 + jitter);
    });
  };

  const setupScramble = (root: HTMLElement): void => {
    if (initialized.has(root)) return;

    const output = root.querySelector<HTMLElement>("[data-scramble-output]");
    if (!output) return;

    initialized.add(root);

    const finalText = root.dataset.scrambleText ?? output.textContent ?? "";
    const glyphs = getGlyphs(root.dataset.scrambleChars ?? DEFAULT_CHARSET);
    const duration = gsap.utils.clamp(
      0.2,
      20,
      toNumber(root.dataset.scrambleSpeed, 1.2)
    );
    const delay = gsap.utils.clamp(
      0,
      10,
      toNumber(root.dataset.scrambleDelay, 0)
    );
    const respectReducedMotion =
      root.dataset.scrambleReducedMotion === "true";
    const playOnView = root.dataset.scramblePlayOnView === "true";

    const states: ScrambleChar[] = splitGraphemes(finalText).map(
      (character) => ({
        final: character,
        isWhitespace: /^\s$/u.test(character),
        current: character,
        revealAt: 1,
      })
    );

    randomizeSchedule(states);

    let lastScramble = 0;

    /** Compone el texto visible para un progreso 0–1. */
    const render = (progress: number): void => {
      const now = performance.now();

      // Limitar los cambios de glifo a ~22 fps: menos repintados, misma estética.
      const shouldScramble = now - lastScramble > 45;
      if (shouldScramble) lastScramble = now;

      let nextText = "";

      for (const state of states) {
        if (state.isWhitespace || progress >= state.revealAt) {
          state.current = state.final;
        } else if (shouldScramble) {
          state.current = randomGlyph(glyphs);
        }

        nextText += state.current;
      }

      if (output.textContent !== nextText) {
        output.textContent = nextText;
      }
    };

    const finish = (): void => {
      // Al terminar volvemos a un único nodo de texto: así el layout final es
      // idéntico al de la capa de medida, sin diferencias de redondeo por spans.
      output.textContent = finalText;
      for (const state of states) state.current = state.final;

      root.dataset.scrambleState = "idle";
      root.dispatchEvent(new CustomEvent("scramble:end", { bubbles: true }));
    };

    const play = (): void => {
      activeTweens.get(root)?.kill();

      root.dataset.scrambleState = "playing";
      root.dispatchEvent(new CustomEvent("scramble:start", { bubbles: true }));

      // Accesibilidad: si el usuario prefiere menos movimiento, texto final ya.
      if (
        respectReducedMotion &&
        window.matchMedia("(prefers-reduced-motion: reduce)").matches
      ) {
        finish();
        return;
      }

      // Reiniciar el caos y barajar el orden de fijación en cada reproducción.
      randomizeSchedule(states);
      for (const state of states) {
        state.current = state.isWhitespace
          ? state.final
          : randomGlyph(glyphs);
      }
      output.textContent = states.map((state) => state.current).join("");

      const progress = { value: 0 };

      const tween = gsap.to(progress, {
        value: 1,
        duration,
        delay,
        ease: "none",
        onUpdate: () => render(progress.value),
        onComplete: finish,
      });

      activeTweens.set(root, tween);
    };

    // API declarativa: cualquier elemento puede disparar la animación.
    root.addEventListener("scramble:play", play);

    if (playOnView) {
      const observer = new IntersectionObserver(
        (entries, currentObserver) => {
          if (entries.some((entry) => entry.isIntersecting)) {
            currentObserver.disconnect();
            play();
          }
        },
        { threshold: 0.35 }
      );

      observer.observe(root);
      return;
    }

    // Arrancar en el siguiente frame para no bloquear el primer render.
    requestAnimationFrame(play);
  };

  const initScrambleText = (): void => {
    document
      .querySelectorAll<HTMLElement>("[data-scramble-text]")
      .forEach(setupScramble);
  };

  // Carga inicial y navegaciones con <ViewTransitions />.
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initScrambleText, {
      once: true,
    });
  } else {
    initScrambleText();
  }

  document.addEventListener("astro:page-load", initScrambleText);
</script>
